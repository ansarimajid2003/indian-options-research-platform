[Unit]
Description=Wing-6 Dashboard API (FastAPI + uvicorn)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5
# The API is read-only. Starting without the paper engine is allowed (returns empty data).

[Service]
User=root
WorkingDirectory=/DATA/live-paper/indian-markets
EnvironmentFile=/DATA/live-paper/indian-markets/.env.live
Environment=LIVE_ROOT=/media/WD-Storage/indian-markets-live
ExecStart=/DATA/live-paper/indian-markets/.venv/bin/uvicorn \
    scripts.live.api.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --log-level info \
    --no-access-log
Restart=on-failure
RestartSec=10

# The dashboard must never affect the paper engine or health monitor.
# It is a disposable viewer process — kill it freely.

[Install]
WantedBy=multi-user.target
