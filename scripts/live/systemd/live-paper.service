[Unit]
Description=Wing-6 Live Paper Trading Engine
Documentation=file:///DATA/live-paper/indian-markets/docs/design/live_paper_trading_plan.md
After=network-online.target health-monitor.service
Wants=network-online.target health-monitor.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/DATA/live-paper/indian-markets
EnvironmentFile=/DATA/live-paper/indian-markets/.env.live
ExecStart=/DATA/live-paper/indian-markets/.venv/bin/python \
    scripts/live/run_paper_trading.py \
    --profile wing6_4x1_all_vix_filtered
Restart=on-failure
# 45s gives the network and Dhan websockets time to stabilise after a crash.
# The engine self-recovers positions from the checkpoint on restart.
RestartSec=45
StandardOutput=append:/media/WD-Storage/indian-markets-live/logs/live-paper.log
StandardError=append:/media/WD-Storage/indian-markets-live/logs/live-paper.log

[Install]
WantedBy=multi-user.target
